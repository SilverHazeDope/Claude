# Скопируй этот файл в .env и впиши свои значения (README, шаги 1–3).

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ от console.anthropic.com
ANTHROPIC_API_KEY=

# Кому можно пользоваться ботом (Telegram ID через запятую).
# ОБЯЗАТЕЛЬНО заполни, иначе любой, кто найдёт бота, будет тратить твои деньги.
# Свой ID бот скажет, если написать ему /start до заполнения.
ALLOWED_USER_IDS=

# Сколько фото в сутки на одного человека
DAILY_LIMIT=30

# Часовой пояс для дневника (граница «сегодня»)
TIMEZONE=Europe/Moscow

# Модель. claude-opus-5-5 — максимум точности; claude-sonnet-5-5 или claude-haiku-5-5 — дешевле.
CLAUDE_MODEL=claude-opus-5-5
